__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# Personal-machine trigger scripts / local secrets -- these can embed a
# GitHub PAT, never commit them.
run_refresh.local.bat
*.local.bat
gh_pat.local

# ons/: downloaded source files and the derived daily store, both
# rebuildable and both far too large for git. CI keeps them in the Actions
# cache instead (see .github/workflows/ons.yml). Thin index.html + wiki-html
# ARE committed; series payloads live on Cloudflare R2.
ons/raw/
ons/data/

# poc/ and contratos/: raw fetched JSON excluded; parquet + payload live on R2.
poc/data/
contratos/data/

# flows/: downloaded ANP source files and the derived daily stores, both
# rebuildable and both too large for git. CI keeps raw/ in the Actions cache
# instead (see .github/workflows/flows.yml). Thin index.html is committed;
# series payloads live on Cloudflare R2.
flows/raw/
flows/data/
flows/tso/_crosswalk_proposals.json
flows/tso/__pycache__/

# supply/: ANP PPGN-EL + import CSVs and derived monthly parquet — rebuildable;
# CI caches raw/. supply/index.html is committed; payload on R2.
supply/raw/
supply/data/

# pld/: CCEE yearly CSVs cached in CI; parquet + payload on R2.
pld/raw/
pld/data/

# precos/: ANP Resolution 52/2011 PPG CSVs and derived parquet — rebuildable;
# CI caches raw/. precos/index.html is committed; payload on R2.
precos/raw/
precos/data/

# desk/: thin shell only; payload on R2 (no own raw store).
# (desk has no data/ — builds from lake/ or sibling project parquet.)

# Track B artifacts (local rebuilds + R2 uploads; not committed).
**/payload.json.gz
hub/teasers.json.gz

# ADR-002 lake mirrors (rebuildable; mirrored to private R2 lake bucket in CI).
lake/**
!lake/README.md

tag_excel/
